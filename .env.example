NODE_ENV=development
APPLICATION_RUNTIME=local
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=20
MAX_AUDIO_FRAME_BYTES=32768
SESSION_RATE_LIMIT_PER_MINUTE=10
ANSWER_RATE_LIMIT_PER_MINUTE=20
AVATAR_RATE_LIMIT_PER_MINUTE=10
AUDIO_FRAME_RATE_PER_SECOND=160
AUDIO_BYTES_PER_SECOND=65536
MAX_AUDIO_DURATION_SECONDS=30
MAX_CONTROL_MESSAGE_BYTES=1024
REQUEST_TIMEOUT_MS=120000

# BFFだけが使用するAzure Speechの非秘密設定
AZURE_SPEECH_ENDPOINT=https://YOUR_CUSTOM_SUBDOMAIN.cognitiveservices.azure.com
SPEECH_RECOGNITION_LANGUAGE=ja-JP
SPEECH_UTTERANCE_TIMEOUT_MS=15000
SPEECH_FINAL_GRACE_MS=750
SPEECH_PHRASES=

# BFFが所有するAvatar/TTS設定。キーや接続文字列は使用しない
SPEECH_SYNTHESIS_VOICE=ja-JP-NanamiNeural
AVATAR_CHARACTER=lisa
AVATAR_STYLE=casual-sitting
AVATAR_RELAY_TIMEOUT_MS=10000
AVATAR_CONNECT_TIMEOUT_MS=30000
AVATAR_SPEAK_TIMEOUT_MS=120000
AVATAR_CLOSE_TIMEOUT_MS=5000
AVATAR_IDLE_TIMEOUT_MS=300000
AVATAR_MAX_CONNECTION_MS=1800000
AVATAR_RECONNECT_MAX_ATTEMPTS=3
AVATAR_RECONNECT_BASE_DELAY_MS=1000
AVATAR_ICE_GATHERING_TIMEOUT_MS=10000
AVATAR_VIDEO_STALL_TIMEOUT_MS=4000

# Phase 3以降でBFFだけが使用する非秘密設定
AZURE_FOUNDRY_BASE_URL=https://YOUR_RESOURCE.services.ai.azure.com/openai/v1/
AZURE_CHAT_DEPLOYMENT=YOUR_CHAT_MODEL_DEPLOYMENT
AZURE_EMBEDDING_DEPLOYMENT=YOUR_EMBEDDING_MODEL_DEPLOYMENT
AZURE_SEARCH_ENDPOINT=https://YOUR_SEARCH.search.windows.net
AZURE_SEARCH_INDEX=knowledge-index
AZURE_SEARCH_SEMANTIC_CONFIG=knowledge-semantic
AZURE_EMBEDDING_DIMENSIONS=1536
SEARCH_TOP_K=5
MAX_ANSWER_QUESTION_CHARS=4000
MAX_ANSWER_HISTORY_ITEMS=10
MAX_ANSWER_HISTORY_CHARS=12000
MAX_RAG_CONTEXT_CHARS=24000
MAX_OUTPUT_TOKENS=1024
SEARCH_TIMEOUT_MS=15000
EMBEDDING_TIMEOUT_MS=30000
MODEL_TIMEOUT_MS=120000
MIN_SENTENCE_CHARS=8
MAX_SENTENCE_CHARS=240
SYNTHESIS_QUEUE_LIMIT=50
